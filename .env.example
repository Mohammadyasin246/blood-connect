# ============================================================================
# BloodConnect — Environment Configuration Template
# ============================================================================

PORT=5000
NODE_ENV=development

# JSON Web Token Secret
JWT_SECRET=bloodconnect_super_secret_jwt_key_2026

# Special Administrator Master Key (for Viva demonstration & high-security auth)
SPECIAL_ADMIN_KEY=ADMIN@SECURE#2026

# ============================================================================
# ⚡ SUPABASE CONFIGURATION (PostgreSQL Backend & Auth)
# ============================================================================
# 1. Create a free project at https://supabase.com
# 2. Go to: Project Settings -> API
# 3. Copy the Project URL, anon public key, and service_role key below:

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# When SUPABASE_URL and keys are provided, BloodConnect automatically connects
# and routes all authentication and information (donors, requests, donations,
# notifications, and admin stats) through Supabase PostgreSQL!
# If left empty, the application falls back smoothly to local SQLite.
